<mxCell id="s32-1" value="&lt;b&gt;Step 3, part 2: the function (a worker that wakes up when a folder is complete)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1000" height="30" as="geometry" /></mxCell>
