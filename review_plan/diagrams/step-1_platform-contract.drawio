<mxfile host="Electron" type="device"><diagram name="Step 1: platform contract" id="s1"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="500" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" />
<mxCell id="s1-1" value="&lt;b&gt;Step 1: platform contract (what Part A provides)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="30" as="geometry" /></mxCell>
<mxCell id="s1-2" value="Laptop" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="230" height="400" as="geometry" /></mxCell>
<mxCell id="s1-3" value="&lt;b&gt;bootstrap.sh&lt;/b&gt;&lt;br&gt;gcloud script&lt;br&gt;run once by the maintainer&lt;br&gt;stands in for Team A" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="190" height="90" as="geometry" /></mxCell>
<mxCell id="s1-4" value="GCP project (europe-west1)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fillColor=#fafafa;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="290" y="40" width="890" height="430" as="geometry" /></mxCell>
<mxCell id="s1-5" value="Part A: created by the script, in this order" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="310" y="80" width="850" height="370" as="geometry" /></mxCell>
<mxCell id="s1-6" value="&lt;b&gt;1. Project&lt;/b&gt;&lt;br&gt;an empty space in Google Cloud&lt;br&gt;no organisation, no folder" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="330" y="125" width="255" height="90" as="geometry" /></mxCell>
<mxCell id="s1-7" value="&lt;b&gt;2. Billing link&lt;/b&gt;&lt;br&gt;who pays for the project" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="605" y="125" width="255" height="90" as="geometry" /></mxCell>
<mxCell id="s1-8" value="&lt;b&gt;3. APIs&lt;/b&gt;&lt;br&gt;11 Google Cloud services switched on" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="880" y="125" width="255" height="90" as="geometry" /></mxCell>
<mxCell id="s1-9" value="&lt;b&gt;4. State bucket&lt;/b&gt;&lt;br&gt;&amp;lt;project-id&amp;gt;-tfstate&lt;br&gt;Terraform's notes; versioning on" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="330" y="245" width="255" height="90" as="geometry" /></mxCell>
<mxCell id="s1-10" value='&lt;b&gt;5. Storage events permission&lt;/b&gt;&lt;br&gt;Cloud Storage may announce&lt;br&gt;"a new file arrived"' style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="605" y="245" width="255" height="90" as="geometry" /></mxCell>
<mxCell id="s1-11" value="&lt;b&gt;6. Budget&lt;/b&gt;&lt;br&gt;10 in the account's currency&lt;br&gt;emails at 50 %, 90 %, 100 %" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="880" y="245" width="255" height="90" as="geometry" /></mxCell>
<mxCell id="s1-12" value="Team B's access (Owner): the maintainer gets it automatically by creating the project.&lt;br&gt;After this, the script never runs again." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="330" y="375" width="800" height="50" as="geometry" /></mxCell>
<mxCell id="s1-13" value="runs once" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="s1-3" target="s1-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
</root></mxGraphModel></diagram></mxfile>
