<mxCell id="pl-13" value="&lt;b&gt;Cloud Build&lt;/b&gt;&lt;br&gt;builds the container&lt;br&gt;runs as content-build" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="620" y="470" width="200" height="70" as="geometry" /></mxCell>
<mxCell id="pl-14" value="BigQuery" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1120" y="260" width="420" height="430" as="geometry" /></mxCell>
<mxCell id="pl-15" value="&lt;b&gt;content_staging: 6 tables&lt;/b&gt;&lt;br&gt;1:1 copies, strict schemas&lt;br&gt;blog_posts, blog_categories, blog_tags,&lt;br&gt;members, articles, article_categories" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1140" y="300" width="380" height="90" as="geometry" /></mxCell>
<mxCell id="pl-16" value="&lt;b&gt;content_cleaned: 3 views&lt;/b&gt;&lt;br&gt;blog_posts, articles (snake_case, nested categories and tags)&lt;br&gt;content (UNION ALL of both)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1140" y="440" width="380" height="80" as="geometry" /></mxCell>
