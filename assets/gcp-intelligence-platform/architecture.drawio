<mxCell id="ab-8" value="Part A: platform (Team A; built with Terraform in the story, stand-in: bootstrap.sh; created once and kept)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="320" y="80" width="1060" height="200" as="geometry" /></mxCell>
<mxCell id="ab-9" value="&lt;b&gt;Project&lt;/b&gt;&lt;br&gt;linked to billing&lt;br&gt;region: europe-west1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="340" y="130" width="162" height="80" as="geometry" /></mxCell>
<mxCell id="ab-30" value="&lt;b&gt;Team B's access&lt;/b&gt;&lt;br&gt;Owner on the project" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="684" y="130" width="162" height="80" as="geometry" /></mxCell>
<mxCell id="ab-10" value="&lt;b&gt;Terraform state bucket&lt;/b&gt;&lt;br&gt;versioning on&lt;br&gt;Part B: prefix content-pipeline" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="512" y="130" width="162" height="80" as="geometry" /></mxCell>
<mxCell id="ab-11" value="&lt;b&gt;Enabled APIs&lt;/b&gt;&lt;br&gt;11 APIs, incl. Cloud Functions,&lt;br&gt;Eventarc, BigQuery, Billing Budget" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="856" y="130" width="162" height="80" as="geometry" /></mxCell>
<mxCell id="ab-12" value="&lt;b&gt;Storage service agent&lt;/b&gt;&lt;br&gt;roles/pubsub.publisher&lt;br&gt;(publishes bucket events)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1028" y="130" width="162" height="80" as="geometry" /></mxCell>
<mxCell id="ab-13" value="&lt;b&gt;Budget&lt;/b&gt;&lt;br&gt;email alerts" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1200" y="130" width="162" height="80" as="geometry" /></mxCell>
<mxCell id="ab-14" value="Contract: Part B assumes these 6 items exist. It never changes Part A's code or removes anything; it adds a few permissions to the project." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="700" y="222" width="660" height="40" as="geometry" /></mxCell>
<mxCell id="ab-15" value="Part B: content pipeline (Team B; standalone Terraform module, 33 resources; built on top of Part A)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="320" y="310" width="1060" height="450" as="geometry" /></mxCell>
<mxCell id="ab-16" value="&lt;b&gt;terraform/deployment/ (root configuration)&lt;/b&gt;&lt;br&gt;backend gcs, provider google, module call&lt;br&gt;inputs: project_id, region&lt;br&gt;outputs: data_bucket_name, dataset_ids, function_name" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="360" width="400" height="80" as="geometry" /></mxCell>
<mxCell id="ab-17" value="&lt;b&gt;Module: terraform/modules/content_pipeline/&lt;/b&gt;&lt;br&gt;no provider or backend block; every name starts with content" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="760" y="360" width="600" height="80" as="geometry" /></mxCell>
<mxCell id="ab-18" value="&lt;b&gt;Storage (2)&lt;/b&gt;&lt;br&gt;&amp;lt;project-id&amp;gt;-content-data&lt;br&gt;raw/, processed/&lt;br&gt;&amp;lt;project-id&amp;gt;-content-source&lt;br&gt;function zip" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="470" width="240" height="120" as="geometry" /></mxCell>
<mxCell id="ab-19" value="&lt;b&gt;Function (2)&lt;/b&gt;&lt;br&gt;content-transform&lt;br&gt;Cloud Storage trigger, reacts to _READY&lt;br&gt;max 2 instances, internal ingress&lt;br&gt;zip upload" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="600" y="470" width="240" height="120" as="geometry" /></mxCell>
<mxCell id="ab-20" value="&lt;b&gt;BigQuery (18)&lt;/b&gt;&lt;br&gt;content_staging: 6 tables&lt;br&gt;content_cleaned: 3 views&lt;br&gt;content_analysis: 6 views&lt;br&gt;3 datasets" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="860" y="470" width="240" height="120" as="geometry" /></mxCell>
<mxCell id="ab-21" value="&lt;b&gt;IAM (11)&lt;/b&gt;&lt;br&gt;content-build, content-trigger,&lt;br&gt;content-runtime&lt;br&gt;8 grants, _iam_member only&lt;br&gt;smallest scope" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1120" y="470" width="240" height="120" as="geometry" /></mxCell>
<mxCell id="ab-22" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Dashed grey: Part A (Team A, shared platform)&lt;br&gt;Blue: Part B (Team B, this module)&lt;br&gt;Purple: identities and roles (Part B)&lt;br&gt;Yellow: laptop" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="340" y="640" width="300" height="100" as="geometry" /></mxCell>
<mxCell id="ab-23" value="terraform destroy removes all 33 Part B resources and their data. Part A stays." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="660" y="640" width="700" height="30" as="geometry" /></mxCell>
