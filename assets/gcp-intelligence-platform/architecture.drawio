<mxCell id="ab-31" value="&lt;b&gt;Checks&lt;/b&gt;&lt;br&gt;pre-commit at each commit&lt;br&gt;GitHub Actions on each pull request" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="210" height="60" as="geometry" /></mxCell>
<mxCell id="ab-5" value="&lt;b&gt;Data files&lt;/b&gt;&lt;br&gt;dummy data (committed)&lt;br&gt;full dataset (git-ignored)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="210" height="60" as="geometry" /></mxCell>
<mxCell id="ab-6" value="&lt;b&gt;upload_data.sh&lt;/b&gt;&lt;br&gt;gcloud storage cp, _READY last" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="210" height="50" as="geometry" /></mxCell>
