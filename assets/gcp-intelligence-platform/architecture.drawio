<diagram name="Part B pipeline" id="pl"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="880" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" />
<mxCell id="pl-1" value="&lt;b&gt;Part B: content pipeline data flow&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1000" height="30" as="geometry" /></mxCell>
