<mxCell id="pl-8" value="&lt;b&gt;raw/&amp;lt;group&amp;gt;/&lt;/b&gt;&lt;br&gt;original JSON files + _READY" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="160" width="200" height="60" as="geometry" /></mxCell>
<mxCell id="pl-9" value="&lt;b&gt;processed/&amp;lt;group&amp;gt;/&lt;/b&gt;&lt;br&gt;6 NDJSON files&lt;br&gt;fixed names, overwritten" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="310" width="200" height="70" as="geometry" /></mxCell>
<mxCell id="pl-10" value="&lt;b&gt;Cloud Storage trigger&lt;/b&gt;&lt;br&gt;Eventarc, object finalised&lt;br&gt;runs as content-trigger&lt;br&gt;needs Part A's service agent grant" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="620" y="150" width="200" height="80" as="geometry" /></mxCell>
<mxCell id="pl-11" value="&lt;b&gt;content-transform&lt;/b&gt;&lt;br&gt;Cloud Run function, Python&lt;br&gt;ignores all but _READY&lt;br&gt;skips events older than 15 min&lt;br&gt;unwraps envelopes, cleans HTML&lt;br&gt;starts load jobs, compares counts&lt;br&gt;runs as content-runtime" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="880" y="120" width="200" height="150" as="geometry" /></mxCell>
