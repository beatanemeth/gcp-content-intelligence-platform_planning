<mxCell id="ab-3" value="&lt;b&gt;bootstrap.sh&lt;/b&gt;&lt;br&gt;gcloud, run once&lt;br&gt;stands in for Team A" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="210" height="60" as="geometry" /></mxCell>
