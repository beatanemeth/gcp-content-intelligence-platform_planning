<mxCell id="ab-1" value="&lt;b&gt;Content pipeline: Part A (platform, Team A) and Part B (feature, Team B)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1000" height="30" as="geometry" /></mxCell>
